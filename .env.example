# Firebase — Taller Pan Sinaí
# Copie este archivo a .env y llénelo con los datos de su proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Config).
# Vite inyecta las variables con prefijo VITE_ en el build.
# Si faltan, la app opera en modo local/demo (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
