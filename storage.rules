rules_version = '2';

// ============================================
// REGLAS DE FIREBASE STORAGE — Taller Pan Sinaí
// Rige las fotos de órdenes (ingreso/salida) y la base
// fotográfica de los vehículos (4 costados por placa).
//
// Mismo criterio que firestore.rules: toda operación exige
// sesión abierta en Firebase Auth. LEER puede cualquier
// sesión (la anónima sostiene la página pública /vehiculo).
// ESCRIBIR exige cuenta real de email y contraseña: la
// sesión anónima no sube, no reemplaza ni borra nada.
// Además, sólo se aceptan imágenes de hasta 10 MB.
// ============================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{ruta=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
